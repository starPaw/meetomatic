[Unit]
Description=Telegram weekly meeting availability bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bot-calendar
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m bot_calendar
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/bot-calendar/data

[Install]
WantedBy=multi-user.target
